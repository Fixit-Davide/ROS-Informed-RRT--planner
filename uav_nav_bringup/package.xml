<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_nav_bringup</name>
  <version>3.0.0</version>
  <description>
    Launch files, parameters and RViz view of the UAV navigation servers (one component
    container with zero-copy map transport by default), plus the PX4 SITL world and model.
  </description>
  <maintainer email="graziato.davide@outlook.it">Davide Graziato</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>uav_map_server</exec_depend>
  <exec_depend>uav_planner_server</exec_depend>
  <exec_depend>uav_planners</exec_depend>
  <exec_depend>uav_controller_server</exec_depend>
  <exec_depend>uav_navigator</exec_depend>
  <!-- used by launch/mapping.launch.py -->
  <exec_depend>drone_pose</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
