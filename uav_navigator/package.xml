<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_navigator</name>
  <version>3.0.0</version>
  <description>
    Lifecycle navigator: serves nav2_msgs/NavigateToPose (and RViz /goal_pose) by driving the
    planner server (compute_path) and the controller server (follow_path): segment chaining,
    replans on blocked paths, retries.
  </description>
  <maintainer email="graziato.davide@outlook.it">Davide Graziato</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>uav_nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
